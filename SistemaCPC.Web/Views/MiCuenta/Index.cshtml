@model EstadoCuenta?
@{
    ViewData["Title"] = "Mi estado de cuenta";
    string Rango(List<string> meses) => meses.Count == 1 ? meses[0] : $"{meses[0]} a {meses[^1]}";
}

<h1>Mi estado de cuenta</h1>

@if (ViewData["Error"] != null)
{
    <div class="alert alert-danger">@ViewData["Error"]</div>
}

@if (Model != null)
{
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-4">
            <div class="card cpc-dato h-100 @(Model.Estado == "Activo" ? "activo" : Model.Estado == "Inactivo" ? "inactivo" : "")">
                <div class="card-body">
                    <h2 class="card-subtitle mb-1">Estado</h2>
                    <p class="card-text"><span class="badge @Formato.ColorEstado(Model.Estado)">@Model.Estado</span></p>
                </div>
            </div>
        </div>
        <div class="col-6 col-sm-4">
            <div class="card cpc-dato h-100">
                <div class="card-body">
                    @if (Model.Deuda < 0)
                    {
                        <h2 class="card-subtitle mb-1">Saldo a favor</h2>
                        <p class="card-text text-success">@Formato.Bs(-Model.Deuda)</p>
                    }
                    else
                    {
                        <h2 class="card-subtitle mb-1">Deuda total</h2>
                        <p class="card-text">@Formato.Bs(Model.Deuda)</p>
                    }
                </div>
            </div>
        </div>
        <div class="col-6 col-sm-4">
            <div class="card cpc-dato h-100">
                <div class="card-body">
                    <h2 class="card-subtitle mb-1">Meses adeudados</h2>
                    <p class="card-text">@Model.MesesAdeudados</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <h2 class="h6">Meses adeudados</h2>
            @if (Model.MesesPorAnio.Count == 0)
            {
                <p class="text-muted">No tiene meses adeudados.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm table-striped align-middle">
                        <thead><tr><th>Año</th><th>Meses</th><th>Monto</th></tr></thead>
                        <tbody>
                            @foreach (var anio in Model.MesesPorAnio)
                            {
                                <tr><td>@anio.Anio</td><td>@Rango(anio.Meses) (@anio.Meses.Count)</td><td>@Formato.Bs(anio.Monto)</td></tr>
                            }
                        </tbody>
                        <tfoot><tr><th colspan="2">Total</th><th>@Formato.Bs(Model.Deuda)</th></tr></tfoot>
                    </table>
                </div>
            }

            <h2 class="h6">Historial de pagos</h2>
            @if (Model.Pagos.Count == 0)
            {
                <p class="text-muted">Todavía no hay pagos registrados.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm table-striped align-middle">
                        <thead><tr><th>Recibo</th><th>Fecha</th><th>Monto</th><th>Meses</th></tr></thead>
                        <tbody>
                            @foreach (var pago in Model.Pagos)
                            {
                                <tr><td>@pago.NumeroRecibo</td><td>@Formato.Fecha(pago.Fecha)</td><td>@Formato.Bs(pago.Monto)</td><td>@pago.MesesCubiertos</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
        <div class="col-md-4 order-first order-md-last">
            <a class="btn btn-primary btn-lg w-100 mb-4" asp-action="Pagar">Pagar mi deuda</a>

            <h2 class="h6">Avisos vigentes</h2>
            <div class="table-responsive">
                <table class="table table-sm table-striped align-middle">
                    <thead><tr><th>Aviso</th><th>Vence</th></tr></thead>
                    <tbody><tr><td>Asamblea general</td><td>30/10/2026</td></tr></tbody>
                </table>
            </div>
        </div>
    </div>
}
