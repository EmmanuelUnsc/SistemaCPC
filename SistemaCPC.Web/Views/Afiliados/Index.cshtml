@{
    ViewData["Title"] = "Afiliados";
}

<h1>Afiliados</h1>

<div class="row mb-4">
    <div class="col-md-8">
        <table class="table table-striped seleccionable">
            <thead>
                <tr><th>Registro</th><th>Nombre</th><th>Estado</th><th>Tribunal</th></tr>
            </thead>
            <tbody>
                <tr data-registro="0457" data-nombre="Nombre Apellido" data-carnet="4567890" data-afiliacion="2015-03-15"
                    data-cobro="2015-04-01" data-tribunal="true">
                    <td>0457</td><td>Nombre Apellido</td><td>Activo</td><td>Sí</td>
                </tr>
                <tr data-registro="0458" data-nombre="Nombre Apellido" data-carnet="5678901" data-afiliacion="2019-07-02"
                    data-cobro="2019-08-01" data-tribunal="false">
                    <td>0458</td><td>Nombre Apellido</td><td>Inactivo</td><td>No</td>
                </tr>
                <tr data-registro="0460" data-nombre="Nombre Apellido" data-carnet="6789012" data-afiliacion="2021-02-10"
                    data-cobro="2021-03-01" data-tribunal="true">
                    <td>0460</td><td>Nombre Apellido</td><td>Activo</td><td>Sí</td>
                </tr>
            </tbody>
        </table>
    </div>
    <div class="col-md-4 d-grid gap-2 align-content-start">
        <button type="button" class="btn btn-success" data-limpiar>Nuevo afiliado</button>
        <button type="button" class="btn btn-outline-primary">Editar</button>
        <button type="button" class="btn btn-outline-danger">Dar de baja</button>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-3">
        <label class="form-label" for="f-registro">Registro</label>
        <input class="form-control" id="f-registro" />
    </div>
    <div class="col-md-6">
        <label class="form-label" for="f-nombre">Nombre completo</label>
        <input class="form-control" id="f-nombre" />
    </div>
    <div class="col-md-3">
        <label class="form-label" for="f-carnet">Carnet</label>
        <input class="form-control" id="f-carnet" />
    </div>
    <div class="col-md-3">
        <label class="form-label" for="f-afiliacion">Fecha de afiliación</label>
        <input type="date" class="form-control" id="f-afiliacion" />
    </div>
    <div class="col-md-3">
        <label class="form-label" for="f-cobro">Inicio de cobro</label>
        <input type="date" class="form-control" id="f-cobro" />
    </div>
    <div class="col-md-3 d-flex align-items-end">
        <div class="form-check">
            <input type="checkbox" class="form-check-input" id="f-tribunal" />
            <label class="form-check-label" for="f-tribunal">Tribunal habilitado</label>
        </div>
    </div>
    <div class="col-md-3">
        <label class="form-label" for="f-baja">Baja</label>
        <select class="form-select" id="f-baja"><option></option><option>Renuncia</option><option>Fallecimiento</option></select>
    </div>
    <div class="col-md-3">
        <label class="form-label" for="f-fechabaja">Fecha de baja</label>
        <input type="date" class="form-control" id="f-fechabaja" />
    </div>
    <div class="col-12">
        <button type="button" class="btn btn-primary">Guardar</button>
    </div>
</div>
