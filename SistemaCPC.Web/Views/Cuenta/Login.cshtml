@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="card cpc-tarjeta-login mx-auto">
    <div class="card-body p-4">
        <div class="text-center mb-3">
            <img src="~/img/logo-cpc.png" alt="Logo del Colegio de Profesionales en Comunicación" class="img-fluid" />
        </div>
        <h1 class="visually-hidden">Colegio de Profesionales en Comunicación</h1>
        <p class="text-center text-muted mb-4">Ingrese con su número de registro</p>

        @if ((ViewData["Error"] ?? TempData["Error"]) is { } error)
        {
            <div class="alert alert-danger">@error</div>
        }

        <form asp-action="Login" method="post">
            <div class="mb-3">
                <label class="form-label" for="registro">Número de registro</label>
                <input type="text" id="registro" name="registro" class="form-control" value="@ViewData["Registro"]" required />
            </div>
            <div class="mb-3">
                <label class="form-label" for="contrasena">Contraseña</label>
                <input type="password" id="contrasena" name="contrasena" class="form-control" required />
            </div>
            <button type="submit" class="btn btn-primary w-100">Ingresar</button>
        </form>
    </div>
</div>
