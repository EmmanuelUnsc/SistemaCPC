@model PantallaAjustes
@{
    ViewData["Title"] = "Registrar ajuste";
}

<h1>Registrar ajuste</h1>

<form asp-action="Index" method="get" class="row g-2 align-items-end mb-3">
    <div class="col-md-4">
        <label class="form-label" for="registro">Número de registro</label>
        <input class="form-control" id="registro" name="registro" value="@Model.Registro" required />
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-primary">Buscar</button>
    </div>
</form>

@if (ViewData["Error"] != null)
{
    <div class="alert alert-danger">@ViewData["Error"]</div>
}

@if (Model.Afiliado is { } afiliado)
{
    <p>Afiliado: <strong>@afiliado.Nombre</strong> (@afiliado.Registro) &nbsp;|&nbsp; Deuda: <strong>@Formato.Bs(afiliado.Deuda)</strong></p>

    <form asp-action="Registrar" method="post" class="row g-3 mb-4">
        <input type="hidden" name="registro" value="@afiliado.Registro" />
        <div class="col-md-4">
            <label class="form-label" for="tipo">Tipo de ajuste</label>
            <select class="form-select" id="tipo" name="tipo"><option>Recibo faltante</option><option>Saldo inicial sin recibo</option></select>
        </div>
        <div class="col-md-3">
            <label class="form-label" for="monto">Monto (Bs)</label>
            <input class="form-control" id="monto" name="monto" inputmode="decimal" required />
            <div class="form-text">Positivo descuenta de la deuda; negativo la aumenta.</div>
        </div>
        <div class="col-md-7">
            <label class="form-label" for="motivo">Motivo (obligatorio)</label>
            <textarea class="form-control" id="motivo" name="motivo" rows="3" required></textarea>
        </div>
        <p class="text-muted mb-0">El ajuste queda en la bitácora con usuario, fecha y valores.</p>
        <div class="col-12">
            <button type="submit" class="btn btn-success">Guardar ajuste</button>
        </div>
    </form>
}

<h2 class="h6">Bitácora</h2>
@if (Model.Bitacora.Count == 0)
{
    <p class="text-muted">Todavía no hay registros.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm table-striped align-middle">
            <thead><tr><th>Fecha</th><th>Usuario</th><th>Motivo</th><th>Deuda anterior</th><th>Deuda nueva</th></tr></thead>
            <tbody>
                @foreach (var b in Model.Bitacora)
                {
                    <tr><td>@Formato.Fecha(b.Fecha)</td><td>@b.Usuario</td><td>@b.Motivo</td><td>@Formato.Bs(b.ValorAnterior)</td><td>@Formato.Bs(b.ValorNuevo)</td></tr>
                }
            </tbody>
        </table>
    </div>
}
