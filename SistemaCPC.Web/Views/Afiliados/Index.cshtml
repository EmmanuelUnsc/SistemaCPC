@{
    ViewData["Title"] = "Afiliados";
}

<h1>Afiliados</h1>
<partial name="_SoloPantalla" />

<div class="row mb-4">
    <div class="col-md-8">
        <table class="table table-striped">
            <thead>
                <tr><th>Registro</th><th>Nombre</th><th>Estado</th><th>Tribunal</th></tr>
            </thead>
            <tbody>
                <tr><td>0457</td><td>Nombre Apellido</td><td>Activo</td><td>Sí</td></tr>
                <tr><td>0458</td><td>Nombre Apellido</td><td>Inactivo</td><td>No</td></tr>
            </tbody>
        </table>
    </div>
    <div class="col-md-4 d-grid gap-2 align-content-start">
        <button type="button" class="btn btn-success">Nuevo afiliado</button>
        <button type="button" class="btn btn-outline-primary">Editar</button>
        <button type="button" class="btn btn-outline-danger">Dar de baja</button>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-3">
        <label class="form-label">Registro</label>
        <input class="form-control" value="0459" />
    </div>
    <div class="col-md-6">
        <label class="form-label">Nombre completo</label>
        <input class="form-control" />
    </div>
    <div class="col-md-3">
        <label class="form-label">Carnet</label>
        <input class="form-control" />
    </div>
    <div class="col-md-3">
        <label class="form-label">Fecha de afiliación</label>
        <input type="date" class="form-control" />
    </div>
    <div class="col-md-3">
        <label class="form-label">Inicio de cobro</label>
        <input type="date" class="form-control" />
    </div>
    <div class="col-md-3 d-flex align-items-end">
        <div class="form-check">
            <input type="checkbox" class="form-check-input" id="tribunal" />
            <label class="form-check-label" for="tribunal">Tribunal habilitado</label>
        </div>
    </div>
    <div class="col-md-3">
        <label class="form-label">Baja</label>
        <select class="form-select"><option>Renuncia</option><option>Fallecimiento</option></select>
    </div>
    <div class="col-md-3">
        <label class="form-label">Fecha de baja</label>
        <input type="date" class="form-control" />
    </div>
    <div class="col-12">
        <button type="button" class="btn btn-primary">Guardar</button>
    </div>
</div>
