@model PantallaPagos
@{
    ViewData["Title"] = "Gestionar pagos";
    var hoy = DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd");
}

<h1>Gestionar pagos</h1>

<form asp-action="Index" method="get" class="row g-2 align-items-end mb-3">
    <div class="col-md-4">
        <label class="form-label" for="registro">Número de registro</label>
        <input class="form-control" id="registro" name="registro" value="@Model.Registro" required />
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-primary">Buscar</button>
    </div>
</form>

@if (ViewData["Error"] != null)
{
    <div class="alert alert-danger">@ViewData["Error"]</div>
}

@if (Model.Afiliado is { } afiliado)
{
    <p>Afiliado: <strong>@afiliado.Nombre</strong> (@afiliado.Registro) &nbsp;|&nbsp; Estado: <span class="badge @Formato.ColorEstado(afiliado.Estado)">@afiliado.Estado</span>
        &nbsp;|&nbsp;
        @if (afiliado.Deuda < 0)
        {
            <span>Saldo a favor: <strong class="text-success">@Formato.Bs(-afiliado.Deuda)</strong></span>
        }
        else
        {
            <span>Deuda: <strong>@Formato.Bs(afiliado.Deuda)</strong></span>
        }
    </p>

    <form method="post" id="formulario-pago">
        <input type="hidden" name="registro" value="@afiliado.Registro" />
        <div class="row">
            <div class="col-md-6">
                <div class="row g-2">
                    <div class="col-6">
                        <label class="form-label" for="f-recibo">Número de recibo</label>
                        <input class="form-control" id="f-recibo" name="numeroRecibo" required />
                    </div>
                    <div class="col-6">
                        <label class="form-label" for="f-fecha">Fecha</label>
                        <input type="date" class="form-control" id="f-fecha" name="fecha" value="@hoy" max="@hoy" />
                    </div>
                    <div class="col-6">
                        <label class="form-label" for="f-meses">Meses cubiertos</label>
                        <input type="number" class="form-control" id="f-meses" name="mesesCubiertos" min="1" max="120" value="1" required />
                    </div>
                    <div class="col-6">
                        <label class="form-label" for="f-monto">Monto (Bs)</label>
                        <input class="form-control" id="f-monto" name="monto" value="@afiliado.AporteMensual.ToString("0.##")"
                               data-aporte="@afiliado.AporteMensual.ToString("0.##")" />
                        <div class="form-text">Al registrar se calcula con los meses; al corregir se guarda este monto.</div>
                    </div>
                    <div class="col-12">
                        <label class="form-label" for="f-motivo">Motivo (solo para corregir)</label>
                        <input class="form-control" id="f-motivo" name="motivo" />
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-success" asp-action="Registrar">Registrar pago</button>
                        <button type="button" class="btn btn-outline-secondary" data-limpiar>Nuevo pago</button>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <h2 class="h6">Pagos registrados</h2>
                @if (Model.Pagos.Count == 0)
                {
                    <p class="text-muted">Todavía no hay pagos registrados.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-striped seleccionable align-middle">
                            <thead><tr><th>Recibo</th><th>Fecha</th><th>Monto</th><th>Meses</th><th>Origen</th></tr></thead>
                            <tbody>
                                @foreach (var pago in Model.Pagos)
                                {
                                    <tr data-recibo="@pago.NumeroRecibo" data-fecha="@pago.Fecha.ToString("yyyy-MM-dd")"
                                        data-monto="@pago.Monto.ToString("0.##")" data-meses="@pago.MesesCubiertos">
                                        <td>@pago.NumeroRecibo</td><td>@Formato.Fecha(pago.Fecha)</td><td>@Formato.Bs(pago.Monto)</td>
                                        <td>@pago.MesesCubiertos</td><td>@pago.Origen</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                <button type="submit" class="btn btn-outline-primary" asp-action="Corregir">Corregir pago</button>
                <p class="text-muted small mt-2">Elija el pago en la tabla, cambie los meses o el monto y escriba el motivo. Cada corrección queda en la bitácora.</p>
            </div>
        </div>
    </form>
}

@section Scripts {
    <script>
        const campoMeses = document.getElementById("f-meses");
        const campoMonto = document.getElementById("f-monto");
        campoMeses?.addEventListener("input", () => {
            campoMonto.value = (Number(campoMeses.value) || 0) * Number(campoMonto.dataset.aporte);
        });
    </script>
}
