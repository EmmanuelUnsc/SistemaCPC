@{
    ViewData["Title"] = "Registrar defensa";
}

<ul class="nav nav-pills mb-3">
    <li class="nav-item"><a class="nav-link active" asp-action="Index">Registrar defensa</a></li>
    <li class="nav-item"><a class="nav-link" asp-action="Pago">Pagar defensa</a></li>
</ul>

<h1>Registrar defensa</h1>

<div class="row g-3">
    <div class="col-md-6">
        <label class="form-label">Número de oficio</label>
        <input class="form-control" value="OF-241/2026" />
    </div>
    <div class="col-md-6">
        <label class="form-label">Universidad</label>
        <select class="form-select"><option>Universidad A</option><option>Universidad B</option></select>
    </div>
    <div class="col-md-6">
        <label class="form-label">Carta recibida</label>
        <input class="form-control" value="Carta N.º 98" />
    </div>
    <div class="col-md-6">
        <label class="form-label">Fecha de la defensa</label>
        <input type="date" class="form-control" value="2026-10-30" />
    </div>
    <div class="col-12">
        <label class="form-label">Tribunal (solo habilitados)</label>
        <select class="form-select"><option>0457 - Nombre Apellido</option></select>
    </div>
    <p class="text-muted mb-0">Un solo tribunal habilitado por defensa. La defensa queda PorPagar.</p>
    <div class="col-12">
        <button type="button" class="btn btn-primary">Guardar defensa</button>
    </div>
</div>
