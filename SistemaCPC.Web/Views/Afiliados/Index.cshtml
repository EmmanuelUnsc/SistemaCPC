@model List<AfiliadoDatos>
@{
    ViewData["Title"] = "Afiliados";
    var hoy = DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd");
    string Iso(DateOnly? fecha) => fecha?.ToString("yyyy-MM-dd") ?? string.Empty;
    var pagina = (int)(ViewData["Pagina"] ?? 1);
    var paginas = (int)(ViewData["Paginas"] ?? 1);
    var desde = (int)(ViewData["Desde"] ?? 0);
    var primera = Math.Max(1, Math.Min(pagina - 2, paginas - 4));
    var ultima = Math.Min(paginas, primera + 4);
}

<h1>Afiliados</h1>

@if (ViewData["Error"] != null)
{
    <div class="alert alert-danger">@ViewData["Error"]</div>
}

<div class="mb-4">
        <div class="table-responsive">
        <table class="table table-sm table-striped seleccionable align-middle">
            <thead>
                <tr><th>Foto</th><th>Registro</th><th>Nombre</th><th>Estado</th><th>Deuda</th><th>Tribunal</th></tr>
            </thead>
            <tbody>
                @foreach (var a in Model)
                    {
                        <tr data-modo="editar" data-registro="@a.Registro" data-original="@a.Registro" data-nombre="@a.Nombre" data-carnet="@a.Carnet"
                        data-afiliacion="@Iso(a.FechaAfiliacion)" data-cobro="@Iso(a.FechaInicioCobro)"
                        data-tribunal="@(a.EsTribunal ? "true" : "false")" data-baja="@a.MotivoBaja" data-fechabaja="@Iso(a.FechaBaja)">
                        <td>
                            @if (a.TieneFoto)
                            {
                                <img src="@Url.Action("Foto", new { id = a.Registro })" alt="Foto de @a.Nombre" width="40" height="40" class="rounded object-fit-cover" />
                            }
                        </td>
                        <td>@a.Registro</td><td>@a.Nombre</td><td><span class="badge @Formato.ColorEstado(a.Estado)">@a.Estado</span></td><td class="text-nowrap">
                            @if (a.Deuda < 0)
                            {
                                <span class="text-success">Saldo a favor @Formato.Bs(-a.Deuda)</span>
                            }
                            else
                            {
                                @Formato.Bs(a.Deuda)
                            }
                        </td>
                        <td>@(a.EsTribunal ? "Sí" : "No")</td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
            <p class="text-muted small mb-0">Afiliados @desde a @(desde + Model.Count - 1) de @ViewData["Total"]. Elija uno para editarlo o darlo de baja.</p>
            @if (paginas > 1)
            {
                <nav aria-label="Páginas de afiliados">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(pagina == 1 ? "disabled" : "")"><a class="page-link" asp-action="Index" asp-route-pagina="1">Primera</a></li>
                        <li class="page-item @(pagina == 1 ? "disabled" : "")"><a class="page-link" asp-action="Index" asp-route-pagina="@(pagina - 1)">Anterior</a></li>
                        @for (var i = primera; i <= ultima; i++)
                        {
                            <li class="page-item @(i == pagina ? "active" : "")"><a class="page-link" asp-action="Index" asp-route-pagina="@i">@i</a></li>
                        }
                        <li class="page-item @(pagina == paginas ? "disabled" : "")"><a class="page-link" asp-action="Index" asp-route-pagina="@(pagina + 1)">Siguiente</a></li>
                        <li class="page-item @(pagina == paginas ? "disabled" : "")"><a class="page-link" asp-action="Index" asp-route-pagina="@paginas">Última</a></li>
                    </ul>
                </nav>
            }
        </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-2">
    <h2 class="h5 mb-0">Datos del afiliado</h2>
    <button type="button" class="btn btn-success" data-limpiar>Nuevo afiliado</button>
</div>

<form asp-action="Guardar" method="post" enctype="multipart/form-data" id="formulario-afiliado" class="row g-3">
    <input type="hidden" id="f-modo" name="modo" />
    <input type="hidden" id="f-original" name="registroOriginal" />
    <div class="col-md-3">
        <label class="form-label" for="f-registro">Registro</label>
        <input class="form-control" id="f-registro" name="registro" required data-solo-al-crear />
    </div>
    <div class="col-md-6">
        <label class="form-label" for="f-nombre">Nombre completo</label>
        <input class="form-control" id="f-nombre" name="nombre" required />
    </div>
    <div class="col-md-3">
        <label class="form-label" for="f-carnet">Carnet</label>
        <input class="form-control" id="f-carnet" name="carnet" />
    </div>
    <div class="col-md-3">
        <label class="form-label" for="f-afiliacion">Fecha de afiliación</label>
        <input type="date" class="form-control" id="f-afiliacion" name="fechaAfiliacion" required />
    </div>
    <div class="col-md-3">
        <label class="form-label" for="f-cobro">Inicio de cobro</label>
        <input type="date" class="form-control" id="f-cobro" name="fechaInicioCobro" required />
    </div>
    <div class="col-md-3">
        <label class="form-label" for="f-contrasena">Contraseña</label>
        <input type="password" class="form-control" id="f-contrasena" name="contrasena" autocomplete="new-password" />
        <div class="form-text">Obligatoria al registrar; al editar, solo si se cambia.</div>
    </div>
    <div class="col-md-3 d-flex align-items-center">
        <div class="form-check">
            <input type="checkbox" class="form-check-input" id="f-tribunal" name="esTribunal" value="true" />
            <label class="form-check-label" for="f-tribunal">Tribunal habilitado</label>
        </div>
    </div>
    <div class="col-md-6">
        <label class="form-label" for="f-foto">Foto (JPG o PNG, hasta 2 MB)</label>
        <input type="file" class="form-control" id="f-foto" name="foto" accept="image/jpeg,image/png" />
    </div>
    <div class="col-12">
        <button type="submit" class="btn btn-primary">Guardar</button>
    </div>
    <div class="col-12"><hr class="my-1" /><h2 class="h6 mb-0">Dar de baja</h2></div>
    <div class="col-md-3">
        <label class="form-label" for="f-baja">Motivo</label>
        <select class="form-select" id="f-baja" name="baja"><option></option><option>Renuncia</option><option>Fallecimiento</option></select>
    </div>
    <div class="col-md-3">
        <label class="form-label" for="f-fechabaja">Fecha de baja</label>
        <input type="date" class="form-control" id="f-fechabaja" name="fechaBaja" max="@hoy" />
    </div>
    <div class="col-md-3 d-flex align-items-end">
        <button type="submit" class="btn btn-outline-danger" asp-action="Baja" formnovalidate>Dar de baja</button>
    </div>
</form>
