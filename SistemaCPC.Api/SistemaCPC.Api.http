POST {{SistemaCPC.Api_HostAddress}}/api/afiliados
Authorization: Bearer {{directorio.response.body.$.token}}
Content-Type: application/json

{
  "registro": "0910",
  "nombre": "Afiliado de prueba 10",
  "carnet": "1000010",
  "fechaAfiliacion": "2026-09-01",
  "fechaInicioCobro": "2026-09-01",
  "esTribunal": false,
  "contrasena": "clave0910"
}

